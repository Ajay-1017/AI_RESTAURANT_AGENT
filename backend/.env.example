# Copy this file to .env and fill in real values.
# .env is git-ignored; this example file is committed so others know what to set.

APP_NAME="AI Restaurant Agent"
APP_VERSION="0.1.0"
ENVIRONMENT=development

# PostgreSQL via the psycopg 3 driver (required)
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/restaurant_agent

# Separate database used only by pytest (tests drop/create tables in it).
# Must be different from DATABASE_URL. Database tests are skipped if unset.
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/restaurant_agent_test
