# Copy this file to .env and fill in real values.
# .env is git-ignored; this example file is committed so others know what to set.

APP_NAME="AI Restaurant Agent"
APP_VERSION="0.1.0"
ENVIRONMENT=development

# Used from Phase 2 onward (PostgreSQL via psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/restaurant_agent
